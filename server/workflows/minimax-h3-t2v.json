{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "H3 视频模型" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "H3 文本编码器" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "_meta": { "title": "H3 视频 VAE" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "H3 音频 VAE" }
  },
  "5": {
    "class_type": "MiniMaxH3TurboLoRA",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_turbo_v4_step600_ema.safetensors",
      "strength": 1,
      "low_vram": true
    },
    "_meta": { "title": "H3 Turbo 加速" }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "prompt": "A cinematic shot with stable composition, natural motion, coherent lighting, no subtitles, no logo, no watermark.",
      "width": 608,
      "height": 352,
      "length": 124,
      "clip": ["2", 0],
      "vae": ["3", 0]
    },
    "_meta": { "title": "文生视频条件" }
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 1 },
    "_meta": { "title": "随机种子" }
  },
  "8": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["5", 0],
      "conditioning": ["6", 0]
    },
    "_meta": { "title": "基础引导" }
  },
  "9": {
    "class_type": "MiniMaxH3TurboSampler",
    "inputs": {},
    "_meta": { "title": "H3 Turbo 采样器" }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["5", 0],
      "scheduler": "simple",
      "steps": 4,
      "denoise": 1
    },
    "_meta": { "title": "采样计划" }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["7", 0],
      "guider": ["8", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 1]
    },
    "_meta": { "title": "视频采样" }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["3", 0]
    },
    "_meta": { "title": "视频解码" }
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "音频解码" }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12", 0],
      "audio": ["13", 0],
      "fps": 24,
      "bit_depth": 8
    },
    "_meta": { "title": "音视频封装" }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "MiaoHui/H3_T2V",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "保存视频" }
  }
}
