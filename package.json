{
  "name": "aeonquill",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "main": "desktop/electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "app": "npm run build && node server/launcher.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "validate": "node scripts/validate.mjs",
    "validate:quick": "node scripts/validate.mjs --quick",
    "validate:live": "node scripts/validate.mjs --live",
    "validate:api": "node scripts/validate-api.mjs",
    "validate:job-archive": "npm run build && node scripts/validate-job-archive-api.mjs && node scripts/validate-job-archive-ui.mjs",
    "validate:diagnostics": "npm run build && node scripts/validate-diagnostic-bundle-api.mjs && node scripts/validate-diagnostic-bundle-ui.mjs",
    "validate:browser": "node scripts/validate-browser.mjs",
    "validate:mode-splitting": "npm run build && node scripts/validate-mode-splitting.mjs && node scripts/validate-mode-loading-ui.mjs",
    "validate:project-center": "node scripts/validate-project-center.mjs",
    "validate:asset-library": "npm run build && node scripts/validate-asset-library-ui.mjs",
    "validate:workflow-center": "npm run build && node scripts/validate-workflow-center-ui.mjs",
    "validate:custom-workflow": "node scripts/validate-custom-workflow-api.mjs",
    "validate:custom-workflow-ui": "npm run build && node scripts/validate-custom-workflow-ui.mjs",
    "validate:storage-lifecycle": "node scripts/validate-storage-lifecycle-api.mjs",
    "validate:storage-lifecycle-ui": "npm run build && node scripts/validate-storage-lifecycle-ui.mjs",
    "validate:custom-workflow:live": "node scripts/validate-custom-workflow-live.mjs",
    "validate:production-agent": "npm run build && node scripts/validate-production-agent-ui.mjs",
    "validate:video-chain": "npm run build && node scripts/validate-video-chain-api.mjs",
    "validate:video-delivery": "node scripts/validate-video-delivery-quality.mjs",
    "validate:sound-renderer": "node scripts/validate-sound-renderer.mjs",
    "validate:p7": "npm run validate && node scripts/validate-p7-integration.mjs",
    "benchmark:canvas": "node scripts/benchmark-canvas.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:workflows": "node server/validate-workflows.mjs",
    "validate:image-tools": "node server/validate-image-tools.mjs",
    "validate:semantic-api": "node scripts/validate-semantic-api.mjs",
    "validate:masked-edit": "node scripts/validate-masked-edit-api.mjs",
    "benchmark:image-quality": "node scripts/benchmark-image-quality.mjs",
    "benchmark:image-quality:smoke": "node scripts/benchmark-image-quality.mjs --manifest=benchmarks/image-quality/manifest.example.json --allow-incomplete",
    "benchmark:semantic-image-quality": "node scripts/benchmark-semantic-image-quality.mjs",
    "benchmark:semantic-image-quality:smoke": "node scripts/benchmark-semantic-image-quality.mjs --manifest=benchmarks/semantic-image-quality/manifest.example.json --allow-incomplete",
    "benchmark:video-quality": "node scripts/benchmark-video-quality.mjs",
    "audit:video-delivery": "node scripts/audit-video-delivery.mjs",
    "benchmark:h3-workflow": "node scripts/run-h3-quality-smoke.mjs",
    "benchmark:seedvr2-workflow": "node scripts/run-seedvr2-quality-smoke.mjs",
    "desktop:electron": "npm run build && electron .",
    "validate:desktop:electron": "npm run build && node scripts/validate-desktop-electron.mjs",
    "package:desktop:electron": "npm run build && node scripts/package-electron.mjs",
    "validate:desktop:electron:packaged": "node scripts/validate-desktop-electron.mjs --packaged",
    "build:desktop:sidecar": "npm run build && node scripts/build-node-sidecar.mjs",
    "validate:desktop:sidecar": "node scripts/validate-node-sidecar.mjs",
    "check:desktop:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-toolchain.ps1 check",
    "build:desktop:tauri:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-toolchain.ps1 debug",
    "package:desktop:tauri": "npm run build:desktop:sidecar && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-toolchain.ps1 bundle && npm run stage:desktop:release",
    "package:desktop:signed": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/package-signed-desktop.ps1",
    "package:desktop:lightweight": "npm run package:desktop:signed && npm run validate:desktop:sidecar && npm run validate:desktop:tauri:release && npm run validate:desktop:single-instance:release && npm run validate:desktop:release-manifest && npm run stage:desktop:lightweight && npm run validate:desktop:lightweight",
    "validate:desktop:tauri": "node scripts/validate-desktop-tauri.mjs",
    "validate:desktop:tauri:release": "node scripts/validate-desktop-tauri.mjs --release",
    "validate:desktop:single-instance": "node scripts/validate-desktop-single-instance.mjs",
    "validate:desktop:single-instance:release": "node scripts/validate-desktop-single-instance.mjs --release",
    "validate:desktop:tauri:installer": "node scripts/validate-tauri-installer.mjs",
    "stage:desktop:release": "node scripts/stage-desktop-release.mjs",
    "stage:desktop:lightweight": "node scripts/stage-lightweight-release.mjs",
    "validate:desktop:lightweight": "node scripts/validate-lightweight-release.mjs",
    "validate:desktop:release-manifest": "node scripts/validate-release-manifest.mjs",
    "stage:desktop:runtime": "node scripts/stage-offline-runtime.mjs",
    "validate:desktop:runtime": "node scripts/validate-offline-runtime.mjs",
    "validate:desktop:runtime:full": "node scripts/validate-offline-runtime.mjs --full",
    "validate:desktop:comfy": "node scripts/validate-offline-comfy.mjs",
    "validate:desktop:offline-sidecar": "node scripts/validate-offline-sidecar.mjs",
    "validate:desktop:offline-video": "node scripts/validate-offline-video.mjs",
    "stage:desktop:full-offline": "node scripts/stage-full-offline-release.mjs",
    "validate:desktop:full-offline": "node scripts/validate-full-offline-release.mjs",
    "validate:desktop:turnkey-boundary": "node scripts/validate-turnkey-boundary.mjs",
    "package:desktop:full-offline": "npm run package:desktop:turnkey",
    "package:desktop:turnkey": "\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -ExecutionPolicy Bypass -File scripts/package-turnkey.ps1",
    "validate:desktop:release": "npm run validate:desktop:sidecar && npm run validate:desktop:electron:packaged && npm run validate:desktop:tauri:release && npm run validate:desktop:tauri:installer && npm run validate:desktop:release-manifest && npm run benchmark:desktop",
    "benchmark:desktop": "node scripts/benchmark-desktop-shells.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^6.22.0",
    "electron": "^43.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
